<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SixLabors.ImageSharp.Video</AssemblyName>
    <AssemblyTitle>SixLabors.ImageSharp.Video</AssemblyTitle>
    <RootNamespace>SixLabors.ImageSharp</RootNamespace>
    <PackageId>SixLabors.ImageSharp.Video</PackageId>
    <Description>Experimental, fully managed video decoding (AV1) for SixLabors.ImageSharp, with a codec-agnostic Video API.</Description>
    <PackageTags>ImageSharp Video AV1 AOMedia Codec Decoder NetCore</PackageTags>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!--  Enable nullable analysis and treat all nullable warnings as errors, matching the core library. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <Choose>
    <When Condition="$(SIXLABORS_TESTING_PREVIEW) == true">
      <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <TargetFrameworks>net8.0</TargetFrameworks>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <InternalsVisibleTo Include="SixLabors.ImageSharp.Codecs.Av1.Tests" Key="$(SixLaborsPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageSharp\ImageSharp.csproj" />
  </ItemGroup>

  <Import Project="..\..\shared-infrastructure\src\SharedInfrastructure\SharedInfrastructure.projitems" Label="Shared" />

</Project>
